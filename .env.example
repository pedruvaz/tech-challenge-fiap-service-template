# Porta HTTP
PORT=3000
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info

# OpenTelemetry (tudo desligado por padrão; ver src/tracing.ts)
OTEL_SERVICE_NAME=service-template
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_TRACES_EXPORTER=console
# OTEL_SDK_DISABLED=false

# Mensageria: memory (local/testes) ou sqs (produção)
MESSAGING_DRIVER=memory
# Fila de entrada deste serviço (nome lógico) e a URL dela (só no sqs)
MESSAGING_INBOUND_QUEUE=service-template.commands
MESSAGING_INBOUND_QUEUE_URL=
# Filas de destino: MESSAGING_QUEUE_<NOME_LOGICO> (. e - viram _), só no sqs
MESSAGING_QUEUE_ORCHESTRATOR_REPLIES=
# MESSAGING_QUEUE_BILLING_COMMANDS=
# Intervalo do relay do outbox (ms)
OUTBOX_POLL_INTERVAL_MS=1000

# AWS (só no sqs; credenciais vêm do ambiente/IRSA)
AWS_REGION=us-east-1
